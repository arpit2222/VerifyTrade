{
  "name": "verifytrade",
  "version": "1.0.0",
  "private": true,
  "description": "Fair DeFi trading execution with cryptographic proofs on 0G network",
  "workspaces": [
    "contracts",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "build:contracts": "npm run compile --workspace=contracts",
    "test": "npm run test --workspace=contracts",
    "test:coverage": "npm run coverage --workspace=contracts",
    "deploy:testnet": "npm run deploy:testnet --workspace=contracts",
    "verify": "npm run verify --workspace=contracts",
    "typechain": "npm run typechain --workspace=contracts",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,sol,json,md}\"",
    "clean": "rm -rf contracts/artifacts contracts/cache contracts/typechain-types frontend/.next frontend/out node_modules",
    "setup": "bash setup.sh"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "prettier-plugin-solidity": "^1.3.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
