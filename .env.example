# =============================================================================
# VerifyTrade Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git — it is already in .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# WALLET / DEPLOYER
# -----------------------------------------------------------------------------
# Private key of the wallet used to deploy contracts (no 0x prefix)
# Get from MetaMask: Account Details → Export Private Key
# Fund with Arbitrum Sepolia ETH from: https://faucet.triangleplatform.com/arbitrum/sepolia
PRIVATE_KEY=537cbb3b72ebdfeaa5442aaaea50c11b20af63cf94ef1ec26cfb105fb9a03bfd

# -----------------------------------------------------------------------------
# RPC ENDPOINTS
# -----------------------------------------------------------------------------
# Arbitrum Sepolia RPC URL
# Options:
#   - Alchemy:  https://arb-sepolia.g.alchemy.com/v2/<YOUR_KEY>  (recommended)
#   - Infura:   https://arbitrum-sepolia.infura.io/v3/<YOUR_KEY>
#   - Public:   https://sepolia-rollup.arbitrum.io/rpc  (rate-limited)
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/your_alchemy_key

# Local development node (Hardhat)
LOCAL_RPC_URL=http://127.0.0.1:8545

# -----------------------------------------------------------------------------
# API KEYS — BLOCK EXPLORERS
# -----------------------------------------------------------------------------
# Arbiscan API key for contract verification
# Get from: https://arbiscan.io/myapikey
ARBISCAN_API_KEY=T2VUZYV9DX62SCAJUS3FHR6SCGBDQSFXY3

# -----------------------------------------------------------------------------
# WALLET CONNECT
# -----------------------------------------------------------------------------
# WalletConnect v2 Project ID — required for Web3Modal
# Get from: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=00c94b6ac37ab9b26972af7535ae7444

# -----------------------------------------------------------------------------
# DEPLOYED CONTRACT ADDRESSES (filled after running: npm run deploy:testnet)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VERIFY_TRADE_ADDRESS=
NEXT_PUBLIC_VERIFIABLE_TRADE_EXECUTOR_ADDRESS=
NEXT_PUBLIC_FAIRNESS_PROOF_ADDRESS=
NEXT_PUBLIC_MEV_REGISTRY_ADDRESS=

# -----------------------------------------------------------------------------
# NETWORK CONFIG
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_CHAIN_NAME=Arbitrum Sepolia
NEXT_PUBLIC_NETWORK_ENV=testnet

# -----------------------------------------------------------------------------
# 0G NETWORK (AI Layer)
# -----------------------------------------------------------------------------
# 0G Newton testnet configuration
# Docs: https://docs.0g.ai
ZEROG_RPC_URL=https://evmrpc-testnet.0g.ai
ZEROG_CHAIN_ID=16600
ZEROG_PRIVATE_KEY=your_0g_wallet_private_key

# 0G Storage node endpoint for proof storage
# Leave empty to use the built-in mock (development mode)
ZEROG_STORAGE_NODE=https://storage-testnet.0g.ai

# 0G Storage API key (if node requires authentication)
ZEROG_STORAGE_API_KEY=

# 0G Compute node endpoint for TEE execution
# Leave empty to use mock TEE (development mode)
ZEROG_COMPUTE_NODE=https://compute-testnet.0g.ai
ZEROG_COMPUTE_API_KEY=

# -----------------------------------------------------------------------------
# GAS SETTINGS
# -----------------------------------------------------------------------------
# Override gas price (in gwei) for deployments — leave empty for auto
GAS_PRICE_GWEI=
# Max fee per gas (EIP-1559) — leave empty for auto
MAX_FEE_PER_GAS_GWEI=

# -----------------------------------------------------------------------------
# OPTIONAL: ANALYTICS & MONITORING
# -----------------------------------------------------------------------------
# Vercel Analytics (populated automatically on Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Sentry DSN for error tracking
SENTRY_DSN=

# -----------------------------------------------------------------------------
# DEVELOPMENT FLAGS
# -----------------------------------------------------------------------------
# Enable mock data for frontend development without a deployed contract
NEXT_PUBLIC_USE_MOCK_DATA=false

# Show debug panels in the UI
NEXT_PUBLIC_DEBUG_MODE=false

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# AES-256-GCM encryption key for order privacy (any random 32+ byte string)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_random_32_byte_hex_string

# Private key of the executor/relayer wallet (may be same as PRIVATE_KEY on testnet)
EXECUTOR_PRIVATE_KEY=

# CORS allowed origin for API routes (default: * for development)
# In production: set to your frontend domain e.g. https://verifytrade.xyz
CORS_ORIGIN=*
