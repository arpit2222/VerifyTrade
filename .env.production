# =============================================================================
# VerifyTrade — Production Environment Variables
# =============================================================================
# Copy to your hosting provider's environment variable settings.
# NEVER commit this file to git.
#
# For Vercel:  vercel env add <NAME> production
# For Railway: Settings → Variables → Add
# =============================================================================

# -----------------------------------------------------------------------------
# NETWORK — Arbitrum Sepolia (testnet submission)
# Change to 42161 + mainnet RPC for Arbitrum One (mainnet)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_NETWORK_ENV=testnet
NEXT_PUBLIC_CHAIN_NAME=Arbitrum Sepolia

# Arbitrum Sepolia RPC — use Alchemy or Infura in production (not public endpoint)
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE

# Public RPC for frontend (can match the above or use a different provider)
NEXT_PUBLIC_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE

# -----------------------------------------------------------------------------
# SMART CONTRACT ADDRESSES (fill after running: npm run deploy:testnet)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VERIFIABLE_TRADE_EXECUTOR_ADDRESS=0xREPLACE_AFTER_DEPLOY
NEXT_PUBLIC_FAIRNESS_PROOF_ADDRESS=0xREPLACE_AFTER_DEPLOY
NEXT_PUBLIC_MEV_REGISTRY_ADDRESS=0xREPLACE_AFTER_DEPLOY

# -----------------------------------------------------------------------------
# WALLET CONNECT
# Get project ID from: https://cloud.walletconnect.com (free)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# -----------------------------------------------------------------------------
# ENCRYPTION
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes)
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# -----------------------------------------------------------------------------
# EXECUTOR WALLET
# Private key of the server-side executor/relayer wallet.
# This account must be set as the authorised executor on VerifiableTradeExecutor
# and authorised prover on FairnessProof.
# NEVER expose this key to the browser.
# -----------------------------------------------------------------------------
EXECUTOR_PRIVATE_KEY=REPLACE_WITH_EXECUTOR_PRIVATE_KEY_NO_0x_PREFIX

# -----------------------------------------------------------------------------
# 0G NETWORK (Newton testnet)
# Leave empty to use mock mode (all 0G calls are simulated locally).
# Set these for production integration with actual 0G nodes.
# Docs: https://docs.0g.ai
# -----------------------------------------------------------------------------
ZEROG_RPC_URL=https://evmrpc-testnet.0g.ai
ZEROG_CHAIN_ID=16600
ZEROG_PRIVATE_KEY=REPLACE_WITH_0G_WALLET_PRIVATE_KEY

# 0G Storage node — set to enable real storage uploads
ZEROG_STORAGE_NODE=https://storage-testnet.0g.ai
ZEROG_STORAGE_API_KEY=

# 0G Compute node — set to enable real TEE execution
ZEROG_COMPUTE_NODE=https://compute-testnet.0g.ai
ZEROG_COMPUTE_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL FEATURES
# -----------------------------------------------------------------------------

# Arbiscan API key — for contract verification during deployment
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY

# CORS — lock to your frontend domain in production
CORS_ORIGIN=https://verifytrade.vercel.app

# Feature flags
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_DEBUG_MODE=false

# Vercel Analytics (auto-populated on Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
